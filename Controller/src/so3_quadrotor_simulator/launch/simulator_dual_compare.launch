<launch>
    <arg name="init_x" default="0.0"/>
    <arg name="init_z" default="2.0"/>
    <arg name="simple_init_y" default="-0.4"/>
    <arg name="minco_init_y" default="0.4"/>

    <group ns="yopo_simple">
        <node pkg="so3_quadrotor_simulator" type="quadrotor_simulator_so3"
              name="quadrotor_simulator" output="screen">
            <param name="rate/odom" value="100.0"/>
            <param name="simulator/init_state_x" value="$(arg init_x)"/>
            <param name="simulator/init_state_y" value="$(arg simple_init_y)"/>
            <param name="simulator/init_state_z" value="$(arg init_z)"/>
            <param name="quadrotor_name" value="yopo_simple/base_link"/>
            <param name="mesh/color_r" value="1.0"/>
            <param name="mesh/color_g" value="0.45"/>
            <param name="mesh/color_b" value="0.05"/>
            <remap from="~odom" to="odom"/>
            <remap from="~imu" to="imu"/>
            <remap from="~uav" to="uav"/>
            <remap from="~cmd" to="so3_cmd"/>
            <remap from="~force_disturbance" to="force_disturbance"/>
            <remap from="~moment_disturbance" to="moment_disturbance"/>
        </node>

        <node pkg="so3_control" type="network_control_node"
              name="network_controller" output="screen">
            <param name="is_simulation" value="true"/>
            <param name="use_disturbance_observer" value="true"/>
            <param name="hover_thrust" value="0.375"/>
            <param name="takeoff_altitude" value="$(arg init_z)"/>
            <param name="record_log" value="false"/>
            <param name="logger_file_name" value="$(find so3_control)/logger/"/>
            <remap from="~odom" to="odom"/>
            <remap from="~imu" to="imu"/>
            <remap from="~position_cmd" to="pos_cmd"/>
            <remap from="~so3_cmd" to="so3_cmd"/>
        </node>
    </group>

    <group ns="yopo_minco">
        <node pkg="so3_quadrotor_simulator" type="quadrotor_simulator_so3"
              name="quadrotor_simulator" output="screen">
            <param name="rate/odom" value="100.0"/>
            <param name="simulator/init_state_x" value="$(arg init_x)"/>
            <param name="simulator/init_state_y" value="$(arg minco_init_y)"/>
            <param name="simulator/init_state_z" value="$(arg init_z)"/>
            <param name="quadrotor_name" value="yopo_minco/base_link"/>
            <param name="mesh/color_r" value="0.05"/>
            <param name="mesh/color_g" value="0.75"/>
            <param name="mesh/color_b" value="1.0"/>
            <remap from="~odom" to="odom"/>
            <remap from="~imu" to="imu"/>
            <remap from="~uav" to="uav"/>
            <remap from="~cmd" to="so3_cmd"/>
            <remap from="~force_disturbance" to="force_disturbance"/>
            <remap from="~moment_disturbance" to="moment_disturbance"/>
        </node>

        <node pkg="so3_control" type="network_control_node"
              name="network_controller" output="screen">
            <param name="is_simulation" value="true"/>
            <param name="use_disturbance_observer" value="true"/>
            <param name="hover_thrust" value="0.375"/>
            <param name="takeoff_altitude" value="$(arg init_z)"/>
            <param name="record_log" value="false"/>
            <param name="logger_file_name" value="$(find so3_control)/logger/"/>
            <remap from="~odom" to="odom"/>
            <remap from="~imu" to="imu"/>
            <remap from="~position_cmd" to="pos_cmd"/>
            <remap from="~so3_cmd" to="so3_cmd"/>
        </node>
    </group>
</launch>
