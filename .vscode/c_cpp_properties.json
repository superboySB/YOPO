{
  "version": 4,
  "configurations": [
    {
      "name": "YOPO-ROS-Noetic",
      "compilerPath": "/usr/bin/g++",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "compileCommands": "${workspaceFolder}/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/Controller/src/**",
        "${workspaceFolder}/Controller/devel/include/**",
        "${workspaceFolder}/Simulator/src/include/**",
        "${workspaceFolder}/Simulator/src/src/**",
        "/opt/ros/noetic/include/**",
        "/usr/include/eigen3/**",
        "/usr/include/opencv4/**",
        "/usr/include/pcl-*/**",
        "/usr/local/cuda/include/**"
      ],
      "defines": [
        "ROS_PACKAGE_NAME=\"sensor_simulator\"",
        "EIGEN_MPL2_ONLY"
      ]
    }
  ]
}
